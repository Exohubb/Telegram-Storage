# ============================================================
# Telegram Bot Configuration
# ============================================================
BOT_TOKEN=8687666451:AAFb-MrEMAf9jLfA12OqdU2xkj8WngCaxbY
BOT_WEBHOOK_SECRET=your_random_webhook_secret_here

# The private Telegram channel used as the file vault
# Must be a channel where the bot is admin with post/delete permissions
# Format: -100xxxxxxxxxx (negative number for channels)
VAULT_CHANNEL_ID=-1001234567890

# ============================================================
# Database (Supabase PostgreSQL)
# ============================================================
DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxxx.supabase.co:5432/postgres

# ============================================================
# Application
# ============================================================
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000

# Public URL where Render deploys your service (no trailing slash)
# Example: https://my-bot.onrender.com
WEBHOOK_BASE_URL=https://your-app.onrender.com

# ============================================================
# Admin
# ============================================================
# Comma-separated Telegram user IDs with admin access
ADMIN_USER_IDS=123456789,987654321

# ============================================================
# Bot Behavior
# ============================================================
# Where to put files uploaded without a folder selection
# Options: "ask" | "default"
DEFAULT_UPLOAD_BEHAVIOR=ask

# Upload session timeout in seconds (default: 300 = 5 minutes)
UPLOAD_SESSION_TIMEOUT=300

# Max folder name length
MAX_FOLDER_NAME_LENGTH=64

# Max tag length
MAX_TAG_LENGTH=32

# Max tags per file
MAX_TAGS_PER_FILE=10

# Max search query length
MAX_SEARCH_QUERY_LENGTH=128

# Files per page in listings
PAGE_SIZE=8

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO
